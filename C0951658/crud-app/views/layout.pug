// views/layout.pug
// Main layout template

doctype html 
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || 'User CRUD App'
    link(rel="stylesheet", href="https://www.w3schools.com/w3css/4/w3.css")
    style.
        .form-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .table-container {
            overflow-x: auto;
        }
        .success-message {
            background-color: #d4edda;
            color: #155724;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 20px;
        }
        .error-message {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 20px;
        }
        .required::after {
            content: " *";
            color: red;
        }

  body
    nav.w3-bar.w3-blue
        a.w3-bar-item.w3-button(href="/") 
            strong User Management System
        a.w3-bar-item.w3-button(href="/users") View Users
        a.w3-bar-item.w3-button.w3-padding-left(href="/users/add") Add User
  
    .w3-container.w3-margin-top           
        if message
            .success-message= message
        
        if errors
            each error in errors
                .error-message= error

        block content

    footer.w3-container.w3-blue.w3-center.w3-padding-16
        p &copy; 2025 User Management System - Vishwadeepsinh Vaghela - C0951658